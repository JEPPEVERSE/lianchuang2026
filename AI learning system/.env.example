# DeepSeek 当前官方接口；可替换为兼容 chat/completions 的服务。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_JSON_MODE=1
LLM_TIMEOUT=90
# 本任务默认关闭思考以降低耗时；复杂证明可显式 enabled。
LLM_THINKING=disabled
LLM_ANALYSIS_MAX_TOKENS=8192
LLM_QA_MAX_TOKENS=2048
LLM_ANALYSIS_BATCH_CHARS=3000
LLM_LOG_STATS=1

# Level 3: local embedding; fixed revision prevents mixed indexes.
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_REVISION=7999e1d3359715c523056ef9478215996d62a620
EMBED_DEVICE=cpu
# Hugging Face inaccessible? Explicitly set HF_ENDPOINT=https://hf-mirror.com
LLM_OPENIE_MAX_TOKENS=4096
LLM_RECOGNITION_MAX_TOKENS=2048
LLM_UPDATER_MAX_TOKENS=4096
LLM_PLANNER_MAX_TOKENS=4096
