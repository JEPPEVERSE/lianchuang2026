# DeepSeek 当前官方接口；可替换为兼容 chat/completions 的服务。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_JSON_MODE=1
LLM_TIMEOUT=90
# 本任务默认关闭思考以降低耗时；复杂证明可显式 enabled。
LLM_THINKING=disabled
LLM_ANALYSIS_MAX_TOKENS=8192
LLM_QA_MAX_TOKENS=2048
LLM_ANALYSIS_BATCH_CHARS=3000
LLM_LOG_STATS=1
